# systemd unit for server-agent (install on every server you monitor).
# Setup steps are in the README ("Server setup").

[Unit]
Description=server-dashboard stats agent
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/server-agent/agent.env
ExecStart=/usr/local/bin/server-agent
Restart=always
RestartSec=5

# Runs as the unprivileged `server-agent` system user. Put that user in the
# `docker` group for container stats/controls, and install the polkit rule
# from deploy/ if you want the reboot button.
User=server-agent
Group=server-agent
StateDirectory=server-agent
Environment=HOME=/var/lib/server-agent
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
