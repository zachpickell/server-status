# Listen on this server's Tailscale IP so the agent isn't exposed to the internet.
# Find it with: tailscale ip -4
AGENT_LISTEN=100.x.y.z:9100

# Shared secret. Generate one with: openssl rand -hex 32
# Use the same value for this server in your server-status config and in the
# web panel. Container controls are only enabled when a token is set.
AGENT_TOKEN=change-me

# Allow the web panel's Reboot button for this server. Also needs the polkit
# rule from deploy/ installed. Leave false to never allow reboots.
AGENT_ALLOW_REBOOT=false
